<?xml version="1.0" encoding="utf-8"?>
<!-- 屏幕顶层的回答浮窗（由 FloatService 通过 WindowManager 加到系统悬浮层） -->
<com.huaci.ai.PanelRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- 标题栏：按住可拖动浮窗 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPaste"
                style="@style/PanelIconBtn"
                android:contentDescription="用剪贴板里的文字"
                android:text="粘贴" />

            <TextView
                android:id="@+id/btnMin"
                style="@style/PanelIconBtn"
                android:contentDescription="收起成悬浮球"
                android:text="收起" />

            <TextView
                android:id="@+id/btnClose"
                style="@style/PanelIconBtn"
                android:contentDescription="关闭浮窗"
                android:text="✕"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 选中的原文，点一下展开/收起 -->
    <TextView
        android:id="@+id/quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_quote"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <!-- 预设问题 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 对话 -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/thread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp" />
    </ScrollView>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="点上面的预设问题，\n或在下面直接提问"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <!-- 状态 + 操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnStop"
            style="@style/PanelIconBtn"
            android:text="停止"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnCopy"
            style="@style/PanelIconBtn"
            android:text="复制回答" />

        <TextView
            android:id="@+id/btnClear"
            style="@style/PanelIconBtn"
            android:text="清空" />
    </LinearLayout>

    <!-- 输入框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="追问，或问点别的…"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_accent"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="发送"
            android:textColor="@color/accent_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.huaci.ai.PanelRoot>
