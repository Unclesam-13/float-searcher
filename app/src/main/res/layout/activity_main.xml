<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="在任何 App 里选中文字，点菜单里的「问 AI」，答案浮在屏幕最上层。"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- 第 1 步：权限 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="第 1 步　允许显示在其他应用上层" />

            <TextView
                android:id="@+id/permStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnPerm"
                style="@style/BtnSoft"
                android:layout_marginTop="12dp"
                android:text="去开启悬浮窗权限" />
        </LinearLayout>

        <!-- 第 2 步：AI 接口 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="第 2 步　填 AI 接口" />

            <RadioGroup
                android:id="@+id/provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/pAnthropic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:buttonTint="@color/accent"
                    android:text="Claude"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/pDeepseek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:buttonTint="@color/accent"
                    android:text="DeepSeek"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/pOpenai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:text="其他兼容接口"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <TextView
                android:id="@+id/providerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="接口地址" />

            <EditText
                android:id="@+id/baseUrl"
                style="@style/Field"
                android:inputType="textUri" />

            <TextView
                style="@style/FieldLabel"
                android:text="API Key" />

            <EditText
                android:id="@+id/apiKey"
                style="@style/Field"
                android:hint="粘贴你的 Key"
                android:inputType="textPassword" />

            <TextView
                style="@style/FieldLabel"
                android:text="模型" />

            <EditText
                android:id="@+id/model"
                style="@style/Field"
                android:inputType="text" />

            <!-- 仅 DeepSeek：一键选模型 + 深度思考开关 -->
            <LinearLayout
                android:id="@+id/deepseekBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pickFlash"
                        style="@style/BtnSoft"
                        android:layout_marginEnd="8dp"
                        android:text="flash · 快又省" />

                    <TextView
                        android:id="@+id/pickPro"
                        style="@style/BtnSoft"
                        android:text="v4-pro · 更强" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/deepThink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/accent"
                    android:text="深度思考（更准，但要多等一会儿）"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTest"
                    style="@style/BtnSoft"
                    android:text="测试连接" />

                <TextView
                    android:id="@+id/testResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 3 步：预设问题 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="第 3 步　预设问题（可改）" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="每行一个，格式：按钮名 | 要 AI 做什么。选中的文字会自动附在后面；也可以用 {text} 指定放的位置。"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/presets"
                style="@style/Field"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp"
                android:minLines="6"
                android:singleLine="false"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/autoRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/accent"
                android:text="选中文字后自动执行第一个预设"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnResetPresets"
                style="@style/BtnSoft"
                android:layout_marginTop="8dp"
                android:text="恢复默认预设" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnStart"
            style="@style/BtnAccent"
            android:layout_marginTop="20dp"
            android:text="保存并开启悬浮球" />

        <TextView
            android:id="@+id/btnStop"
            style="@style/BtnSoft"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="关闭悬浮球" />

        <!-- 用法 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="怎么用" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="• 在浏览器、阅读器、聊天软件里长按选中文字，在弹出的菜单里点「问 AI」（有的机型要先点「⋮ 更多」）。\n• 浮窗出现在屏幕最上层：点预设一键提问，或在底部输入框追问。\n• 按住浮窗顶部可以拖动；点「收起」变回悬浮球，点悬浮球再展开。\n• 微信等不显示「问 AI」的 App：选中后点「分享」→ 划词助手，或先复制，再点浮窗里的「粘贴」。\n• 国产系统（小米、华为、OPPO、vivo）请在设置里允许本 App 后台运行和自启动，否则悬浮球可能被系统清掉。"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
