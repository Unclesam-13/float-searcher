<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="在任何 App 里选中文字，点菜单里的「问 AI」，答案浮在屏幕最上层。"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- 点悬浮球打开什么 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="悬浮球模式" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/modeFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="完整助手\n点悬浮球打开问答浮窗：预设问题、截屏、识字、追问"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/modeQuick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="中译英速查\n点悬浮球只弹出一个输入框和键盘，打中文按回车，直接出英文"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="切换后马上生效。速查模式下，划词「问 AI」、长按悬浮球截屏、点通知栏，仍然打开完整浮窗。"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 第 1 步：权限 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="第 1 步　允许显示在其他应用上层" />

            <TextView
                android:id="@+id/permStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnPerm"
                style="@style/BtnSoft"
                android:layout_marginTop="12dp"
                android:text="去开启悬浮窗权限" />
        </LinearLayout>

        <!-- 第 2 步：AI 接口 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="第 2 步　填 AI 接口" />

            <RadioGroup
                android:id="@+id/provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/pAnthropic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:buttonTint="@color/accent"
                    android:text="Claude"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/pDeepseek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:buttonTint="@color/accent"
                    android:text="DeepSeek"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/pOpenai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:text="其他兼容接口"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <TextView
                android:id="@+id/providerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="接口地址" />

            <EditText
                android:id="@+id/baseUrl"
                style="@style/Field"
                android:inputType="textUri" />

            <TextView
                style="@style/FieldLabel"
                android:text="API Key" />

            <EditText
                android:id="@+id/apiKey"
                style="@style/Field"
                android:hint="粘贴你的 Key"
                android:inputType="textPassword" />

            <TextView
                style="@style/FieldLabel"
                android:text="模型" />

            <EditText
                android:id="@+id/model"
                style="@style/Field"
                android:inputType="text" />

            <!-- 仅 DeepSeek：一键选模型 + 深度思考开关 -->
            <LinearLayout
                android:id="@+id/deepseekBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pickFlash"
                        style="@style/BtnSoft"
                        android:layout_marginEnd="8dp"
                        android:text="flash · 快又省" />

                    <TextView
                        android:id="@+id/pickPro"
                        style="@style/BtnSoft"
                        android:text="v4-pro · 更强" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/webSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/accent"
                    android:text="联网搜索：需要最新信息时自动搜索，回答附来源"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:lineSpacingExtra="3dp"
                    android:text="AI 自己判断要不要搜、搜什么，最多 3 次。浮窗里的「联网」按钮可随时开关。联网时不使用深度思考；每次搜索按 DeepSeek 价格计费（约 0.75 美元 / 1000 次）。"
                    android:textColor="@color/ink_soft"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/deepThink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/accent"
                    android:text="深度思考（更准，但要多等一会儿）"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTest"
                    style="@style/BtnSoft"
                    android:text="测试连接" />

                <TextView
                    android:id="@+id/testResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 3 步：预设问题 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="第 3 步　预设问题（可改）" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="每行一个，格式：按钮名 | 要 AI 做什么。选中的文字会自动附在后面；也可以用 {text} 指定放的位置。"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/presets"
                style="@style/Field"
                android:layout_marginTop="10dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp"
                android:minLines="6"
                android:singleLine="false"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/autoRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/accent"
                android:text="选中文字后自动执行第一个预设"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnResetPresets"
                style="@style/BtnSoft"
                android:layout_marginTop="8dp"
                android:text="恢复默认预设" />
        </LinearLayout>

        <!-- 剪贴板检测 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="剪贴板检测" />

            <CheckBox
                android:id="@+id/clipCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/accent"
                android:text="打开浮窗时检查剪贴板"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:lineSpacingExtra="3dp"
                android:text="有新复制的内容时，浮窗顶部会出现「用这段」。"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="复制后自动提示"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clipWatchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnClipWatch"
                style="@style/BtnSoft"
                android:layout_marginTop="10dp"
                android:text="去无障碍里打开" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="在无障碍列表里找到「划词助手 · 复制后提示」并打开。安卓 13 及以上如果开关是灰色的：到 系统设置 → 应用 → 划词助手 → 右上角 ⋮ → 允许受限制的设置，再回来打开。\n这个服务只用来发现你点了「复制」，不读取屏幕内容。系统读剪贴板时可能会弹出「已从剪贴板粘贴」的提示，这是正常的。"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnStart"
            style="@style/BtnAccent"
            android:layout_marginTop="20dp"
            android:text="保存并开启悬浮球" />

        <TextView
            android:id="@+id/btnStop"
            style="@style/BtnSoft"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="关闭悬浮球" />

        <!-- 用法 -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="怎么用" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:text="• 在浏览器、阅读器、聊天软件里长按选中文字，在弹出的菜单里点「问 AI」（有的机型要先点「⋮ 更多」）。\n• 浮窗出现在屏幕最上层：点预设一键提问，或在底部输入框追问。\n• 截屏：点浮窗右上角「截屏」，或长按悬浮球。第一次要在系统弹窗里点「立即开始」，之后几分钟内不用再确认。拖动选框选区域、拖角调大小，点「放进对话框」后就能对截图提问。\n• 放大镜识字：点浮窗的「识字」，浮窗变成虚线取景框：拖框内部移动，拖边或角改大小，点「识别」识别框里的文字，点「✕」退出。快捷用法：长按标题栏直接拖到文字上，松手就识别。离线识别，不花 API 额度。\n• 按住浮窗标题栏可以拖动；拖右下角 ◢ 改大小（横屏、竖屏分别记住）；点「调节」改透明度。点「—」变回悬浮球，点悬浮球再展开。\n• 中译英速查：在最上面的「悬浮球模式」选它，点悬浮球就只弹出输入框，打中文按回车出英文（输入英文会翻成中文）；点译文复制，点框外或按返回关掉。\n• 剪贴板：复制了文字再点悬浮球，浮窗顶部会出现「用这段」；打开下面的「复制后自动提示」后，复制完悬浮球旁会直接弹出「问 AI」。\n• 微信等不显示「问 AI」的 App：选中后点「分享」→ 划词助手，或先复制，再点浮窗里的「粘贴」。\n• 国产系统（小米、华为、OPPO、vivo）请在设置里允许本 App 后台运行和自启动，否则悬浮球可能被系统清掉。"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
