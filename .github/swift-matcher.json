{
  "problemMatcher": [
    {
      "owner": "swift-error",
      "pattern": [
        {
          "regexp": "^(.+?\\.swift):(\\d+):(\\d+):\\s+(error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
