<Window x:Class="FloatSearcher.InputBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="划词助手"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 扁平小按钮 -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（发送） -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 剪贴板模式的快捷提示词 -->
        <Style x:Key="ChipBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外面留 12px 给阴影 -->
    <Border x:Name="Card" Margin="12" CornerRadius="16"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>

        <StackPanel Margin="10,8,10,8">

            <!-- 第一行：模式 | 输入框 | 按钮 -->
            <Grid x:Name="TopRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ModeChip" Grid.Column="0" CornerRadius="10" Padding="10,0" Height="30"
                        Margin="0,0,8,0" VerticalAlignment="Top" Background="{DynamicResource AccentSoft}">
                    <TextBlock x:Name="ModeLabel" Text="中 → 英" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="Input" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Accent}"
                             SelectionBrush="{DynamicResource Accent}"
                             FontSize="15.5" Padding="2,5,2,5"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="130"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" />
                    <TextBlock x:Name="Placeholder" Text="输入中文，回车翻译成英文" FontSize="15.5"
                               Foreground="{DynamicResource InkSoft}" Margin="4,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                    <Button x:Name="WebBtn" Content="联网" Style="{StaticResource FlatBtn}"
                            ToolTip="DeepSeek 联网搜索：需要最新信息时自动搜索，回答附来源" Visibility="Collapsed" />
                    <Button x:Name="NewBtn" Content="新对话" Style="{StaticResource FlatBtn}"
                            ToolTip="清空这段对话，重新开始" Visibility="Collapsed" />
                    <Button x:Name="SendBtn" Content="↵" Style="{StaticResource AccentBtn}"
                            Width="42" Margin="2,0,0,0" ToolTip="发送（回车）" />
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource FlatBtn}"
                            Margin="2,0,0,0" ToolTip="收起（Esc）" />
                </StackPanel>
            </Grid>

            <!-- 剪贴板内容 -->
            <Border x:Name="ClipCard" Margin="0,8,0,0" CornerRadius="10" Padding="12,8"
                    Background="{DynamicResource Quote}" Visibility="Collapsed" Cursor="Hand"
                    ToolTip="点一下展开 / 收起">
                <StackPanel>
                    <TextBlock x:Name="ClipTitle" Text="剪贴板" FontSize="11.5"
                               Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                    <TextBlock x:Name="ClipText" Margin="0,3,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource InkSoft}" MaxHeight="58"
                               TextTrimming="CharacterEllipsis" />
                    <Image x:Name="ClipImage" Margin="0,5,0,0" MaxHeight="96" Stretch="Uniform"
                           HorizontalAlignment="Left" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>
            </Border>

            <WrapPanel x:Name="Chips" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- 输出：译文 / 对话 -->
            <ScrollViewer x:Name="OutScroll" Margin="0,8,0,0" MaxHeight="420"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <Grid>
                    <StackPanel x:Name="TranslatePanel" />
                    <StackPanel x:Name="ChatPanel" Visibility="Collapsed" />
                    <StackPanel x:Name="ClipPanel" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="Status" Margin="4,6,4,0" FontSize="11.5"
                       Foreground="{DynamicResource InkSoft}" TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
