<Window x:Class="FloatSearcher.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="划词助手"
        Width="300" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">
    <!-- 窗口本身是透明的，只有悬浮图标和展开的扇形能点到；其余地方鼠标直接穿过去 -->
    <Grid x:Name="Root">
        <!-- 扇形展开时的「感应区」：几乎透明，保证鼠标从图标移到选项途中不会让扇形收起 -->
        <Path x:Name="FanHit" Fill="#01000000" Visibility="Collapsed" />

        <Canvas x:Name="FanLayer" />

        <Grid x:Name="BubbleHost" Width="64" Height="64"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- 悬停时向外扩散的光圈 -->
            <Ellipse x:Name="Ring" Width="52" Height="52" StrokeThickness="3"
                     Stroke="{DynamicResource Accent}" Opacity="0"
                     IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="Circle" Width="52" Height="52" Fill="{DynamicResource Accent}"
                     Stroke="{DynamicResource Surface}" StrokeThickness="2">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
                </Ellipse.Effect>
            </Ellipse>

            <TextBlock x:Name="GlyphText" Text="译" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentInk}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
